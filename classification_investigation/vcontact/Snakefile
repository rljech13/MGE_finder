###############################################################################
# Snakefile для vConTACT 3
#
# ── Ожидает:
#     • vConTACT3 в $PATH (или в активной conda-env, указанной в config)
#     • файл с репрезентативными МГЭ — rep_mge_nt.fa            (config.paths.rep_mge_fasta)
#
# ── Выдаёт:
#     • каталог vcontact3_out/  (со всеми таблицами и графами)
#
# Конфигурация читается из vcontact_config.yaml (пути, env и т.д.).
###############################################################################

import sys, pathlib, yaml
sys.path.append("../../scripts")
from logger import Logger

# ──────────────────── конфиг ────────────────────────────────────────────────
configfile: "vcontact_config.yaml"

REP_MGE_NT    = pathlib.Path(config["paths"]["rep_mge_fasta"])
OUTPUT_DIR    = pathlib.Path(config["paths"]["output_dir"])
CONDA_ENV     = config["execution"]["conda_env"]      # conda-env с vConTACT3

LOGS_DIR = OUTPUT_DIR / "logs"
LOGS_DIR.mkdir(parents=True, exist_ok=True)
logger = Logger("vcontact3_pipeline", True, True).get_logger()

# ──────────────────── правила ───────────────────────────────────────────────
rule all:
    input:
        directory(OUTPUT_DIR / "vcontact3_out")

rule run_vcontact3:
    input:
        fasta = REP_MGE_NT
    output:
        directory(OUTPUT_DIR / "vcontact3_out")
    log:
        LOGS_DIR / "vcontact3.log"
    threads: 16
    conda:
        CONDA_ENV            # активируем env с vcontact3
    shell:
        """
        mkdir -p {output} $(dirname {log})
        vcontact3 run\
          --nucleotide  {input.fasta} \
          --output     {output} \
          --threads        {threads} \
          --db-path /home/lam34/vcontactdb \
          --db-version 228 \
          --db-domain prokaryotes \          # надо сделать этот параметр изменяемым через конфиг 
          &> {log}
        """