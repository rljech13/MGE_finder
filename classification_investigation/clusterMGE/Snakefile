###############################################################################
#  MGE NUCLEOTIDE CLUSTER PIPELINE  (≥0.9 ID, ≥0.95 coverage)
###############################################################################

import os, glob, sys, re, tempfile
from pathlib import Path

WORKDIR = Path(workflow.snakefile).parent.resolve()
sys.path.insert(0, str(WORKDIR.parent.parent / "IE_finder" / "scripts"))
from logger import Logger as CustomLogger

# Prefer `mmseqs` on PATH; set MMSEQS_BIN to override (e.g. /path/to/mmseqs).
MMSEQS = os.environ.get("MMSEQS_BIN", "mmseqs")

custom_logger = CustomLogger(name="mge_cluster",
                log_to_console=True,
                log_to_file=True).get_logger()

# ──────────────────────────────  CONFIG  ─────────────────────────────────── #
configfile: "mge_cluster_config.yaml"

USE_FASTA = config["paths"].get("use_fasta", True)  # По умолчанию использовать FASTA
FASTA_GLOB = config["paths"].get("mge_fasta_pattern", "")
GBK_GLOB   = config["paths"].get("mge_gbk_pattern", "")
CONDA_ENV  = config["execution"]["conda_env"]

RES_DIR    = config["mmseqs"]["results_dir"]
TMP_DIR    = config["mmseqs"]["tmp_dir"]
DB_PREFIX      = config["mmseqs"]["db_prefix"]
CLUSTER_PREFIX = config["mmseqs"]["cluster_prefix"]
REPDB_PREFIX   = config["mmseqs"]["repdb_prefix"]

MIN_ID   = config["mmseqs"]["min_seq_id"]     # 0.9
COVERAGE = config["mmseqs"]["coverage"]       # 0.95

DB_INDEX      = f"{DB_PREFIX}.index"
CLUSTER_INDEX = f"{CLUSTER_PREFIX}.index"
REPDB_INDEX   = f"{REPDB_PREFIX}.index"
CLUSTER_TSV   = f"{CLUSTER_PREFIX}.tsv"

COMBINED_FASTA = os.path.join(RES_DIR, "all_mge_nt.fa")
REP_FASTA      = os.path.join(RES_DIR, "rep_mge_nt.fa")
LOGS_DIR       = os.path.join(RES_DIR, "logs")
os.makedirs(LOGS_DIR, exist_ok=True)

# Выбираем источник данных
if USE_FASTA and FASTA_GLOB:
    FASTA_FILES = sorted([f for f in glob.glob(FASTA_GLOB) if os.path.getsize(f) > 0])
    if not FASTA_FILES:
        sys.exit(f"No mge_region.fa found by pattern: {FASTA_GLOB}")
    custom_logger.info(f"Using FASTA files: Found {len(FASTA_FILES)} MGE FASTA files")
    INPUT_FILES = FASTA_FILES
    INPUT_TYPE = "fasta"
else:
    GBK_FILES = sorted(glob.glob(GBK_GLOB))
    if not GBK_FILES:
        sys.exit(f"No mge_annotated.gbk found by pattern: {GBK_GLOB}")
    custom_logger.info(f"Using GBK files: Found {len(GBK_FILES)} annotated GBKs")
    INPUT_FILES = GBK_FILES
    INPUT_TYPE = "gbk"

# ─────────────────────────────  RULE all  ────────────────────────────────── #
rule all:
    input:
        CLUSTER_TSV,
        REP_FASTA,
        f"{RES_DIR}/cluster_stats.tsv"



# ───────────────  COMBINE FASTA FILES  ───────────────────────── #
rule combine_fasta:
    input:  INPUT_FILES
    output: COMBINED_FASTA
    log:    f"{LOGS_DIR}/combine_fasta.log"
    conda:  CONDA_ENV
    shell:
        r"""
        mkdir -p $(dirname {output}) $(dirname {log})
        python - << PY
import sys, pathlib, glob
from Bio import SeqIO

input_type = "{INPUT_TYPE}"
fasta_pattern = "{FASTA_GLOB}"
gbk_pattern = "{GBK_GLOB}"
out_fa = "{output}"
log_f = "{log}"

# Получаем список файлов через glob, чтобы избежать проблем с длиной командной строки
if input_type == "fasta":
    files = sorted([f for f in glob.glob(fasta_pattern) if pathlib.Path(f).stat().st_size > 0])
    file_format = "fasta"
else:
    files = sorted(glob.glob(gbk_pattern))
    file_format = "genbank"

n = 0
with open(out_fa, "w") as fo:
    for file_path in files:
        sample = pathlib.Path(file_path).parent.name
        try:
            for rec in SeqIO.parse(file_path, file_format):
                rec.id = rec.id + "|sample=" + sample
                rec.description = ""
                SeqIO.write(rec, fo, "fasta")
                n += 1
        except Exception as e:
            print("Error processing " + str(file_path) + ": " + str(e), file=sys.stderr)

with open(log_f, "w") as lg:
    lg.write("Processed " + str(n) + " records from " + str(len(files)) + " " + input_type.upper() + " files\n")
PY
        """

# ─────────────────────────  MMSEQS ∙ createdb  ──────────────────────────── #
rule mmseqs_createdb:
    input:  COMBINED_FASTA
    output: DB_INDEX
    log:    f"{LOGS_DIR}/mmseqs_createdb.log"
    conda:  CONDA_ENV
    shell:  """
            {MMSEQS} createdb {input} {DB_PREFIX} &> {log}
            """

# ─────────────────────────  MMSEQS ∙ cluster  ───────────────────────────── #
rule mmseqs_cluster:
    input:  DB_INDEX
    output: CLUSTER_INDEX
    log:    f"{LOGS_DIR}/mmseqs_cluster.log"
    params: tmp=TMP_DIR, id=MIN_ID, cov=COVERAGE
    conda:  CONDA_ENV
    shell:  """
            {MMSEQS} cluster {DB_PREFIX} {CLUSTER_PREFIX} {params.tmp} \
                   --min-seq-id {params.id} -c {params.cov} --seq-id-mode 1 &> {log}
            """

# ───────────────────────  REPR DB via createsubdb  ──────────────────────── #
rule mmseqs_createsubdb_rep:
    input:  CLUSTER_INDEX, DB_INDEX
    output: REPDB_INDEX
    log:    f"{LOGS_DIR}/mmseqs_createsubdb.log"
    conda:  CONDA_ENV
    shell:  """
            {MMSEQS} createsubdb {CLUSTER_PREFIX} {DB_PREFIX} {REPDB_PREFIX} &> {log}
            """

# ───────────────────────  FASTA репрезентативов  ────────────────────────── #
rule mmseqs_result2flat:
    input:  DB_INDEX, REPDB_INDEX
    output: REP_FASTA
    log:    f"{LOGS_DIR}/mmseqs_result2flat.log"
    conda:  CONDA_ENV
    shell:  """
            {MMSEQS} result2flat {DB_PREFIX} {DB_PREFIX} {REPDB_PREFIX} {output} &> {log}
            """

# ─────────────────────────  TSV «кластер»  ──────────────────────────────── #
rule mmseqs_createtsv:
    input:  DB_INDEX, CLUSTER_INDEX
    output: CLUSTER_TSV
    log:    f"{LOGS_DIR}/mmseqs_createtsv.log"
    params: tmp=TMP_DIR
    conda:  CONDA_ENV
    shell:  """
            {MMSEQS} createtsv {DB_PREFIX} {DB_PREFIX} {CLUSTER_PREFIX} {output} {params.tmp} &> {log}
            """

rule cluster_stats:
    input:
        CLUSTER_TSV
    output:
        f"{RES_DIR}/cluster_stats.tsv"
    shell:
        """
        awk '{{cnt[$1]++}} END{{for(c in cnt)print c"\t"cnt[c]}}' {input} \
        | sort -k2,2nr > {output}
        """


